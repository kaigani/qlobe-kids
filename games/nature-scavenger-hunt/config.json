{
  "id": "nature-scavenger-hunt",
  "engine": "coach-timer",
  "title": "Nature Scavenger Hunt",
  "splashEmoji": "emoji:🔎",
  "theme": {
    "world": "field-journal",
    "background": "./assets/bg.jpg"
  },
  "voice": {
    "intro": {
      "clip": "clip:intro",
      "text": "Treasure hunters, look closely. We are hunting for nature clues!"
    },
    "praise": {
      "clip": "clip:praise",
      "text": "What a clever find! Tell me why it counts."
    },
    "cheer": {
      "clip": "clip:cheer",
      "text": "You found a whole collection of nature clues!"
    },
    "clips": {
      "manifest": "./assets/audio/manifest.json"
    }
  },
  "modes": [
    {
      "id": "classic",
      "title": "Five Finds",
      "type": "steps",
      "praise": {
        "clip": "clip:praise",
        "text": "What a clever find! Tell me why it counts."
      },
      "cheer": {
        "clip": "clip:classic-cheer",
        "text": "Five fantastic finds! You noticed texture, color, shape, size, and sound."
      },
      "endTitle": "Five Finds",
      "endArt": "emoji:🔎",
      "againLabel": "HUNT AGAIN",
      "doneLabel": "FOUND IT",
      "steps": [
        {
          "art": "emoji:🪨",
          "say": {
            "clip": "clip:classic-s1",
            "text": "Find something smooth. Hold it up and say why it counts."
          },
          "timerSec": 90,
          "after": {
            "clip": "clip:classic-s1-after",
            "text": "Time to show your smooth treasure and say why it counts."
          }
        },
        {
          "art": "emoji:🍃",
          "say": {
            "clip": "clip:classic-s2",
            "text": "Find something green. Hold it up and say why it counts."
          }
        },
        {
          "art": "emoji:⚪",
          "say": {
            "clip": "clip:classic-s3",
            "text": "Find something round. Hold it up and say why it counts."
          }
        },
        {
          "art": "emoji:🐜",
          "say": {
            "clip": "clip:classic-s4",
            "text": "Find something tiny. Hold it up and say why it counts."
          }
        },
        {
          "art": "emoji:🎶",
          "say": {
            "clip": "clip:classic-s5",
            "text": "Find something that makes a sound when you shake it. Hold it up and say why it counts."
          }
        }
      ]
    },
    {
      "id": "texture",
      "title": "Feely Hunt",
      "type": "steps",
      "praise": {
        "clip": "clip:texture-praise",
        "text": "Ooh, what does your treasure feel like?"
      },
      "cheer": {
        "clip": "clip:texture-cheer",
        "text": "Feely hunt complete! Your fingertips discovered four textures."
      },
      "endTitle": "Feely Hunt",
      "endArt": "emoji:🪶",
      "againLabel": "FEEL AGAIN",
      "doneLabel": "FOUND IT",
      "steps": [
        {
          "art": "emoji:🌰",
          "say": {
            "clip": "clip:texture-s1",
            "text": "Find something bumpy. Feel all the little bumps."
          }
        },
        {
          "art": "emoji:🪶",
          "say": {
            "clip": "clip:texture-s2",
            "text": "Find something soft. Touch it gently."
          }
        },
        {
          "art": "emoji:🧊",
          "say": {
            "clip": "clip:texture-s3",
            "text": "Find something cold. Touch it for just a moment."
          }
        },
        {
          "art": "emoji:🌾",
          "say": {
            "clip": "clip:texture-s4",
            "text": "Find something tickly. Now close your eyes and feel-test all your treasures."
          }
        }
      ]
    }
  ]
}
