    "jar": "./assets/jar.png",
    "water": {
      "_note": "The target is splash.webp's painted jar water (#81b8c1 near the surface, #6fa9ba down by the floor). baseColor is NOT that colour: it is the PIGMENT, laid under three near-white coats in a row (baseAlpha over the painted glass, then color/alpha as the film over the objects, then glassAlpha re-painting jar.png as front glass), which together throw away about two thirds of its depth. Mixed to match the plate by eye it arrives as fog; mixed this strong it arrives as water. baseAlpha stays in the 0.55–0.65 band on purpose — any higher and the wash stops being water in a painted jar and becomes a slab of colour over it, hiding the glass. color/alpha is deliberately light, because a white spoon on the jar floor has to stay a white spoon. surfaceAlpha is low because lab.js draws the real waterline (band + wavy white stroke + echo); this is only the tint under it.",
      "baseColor": "#12708a",
      "baseAlpha": 0.63,
      "color": "#9ed3e0",
      "alpha": 0.17,
      "surfaceColor": "#dcf0f2",
      "surfaceAlpha": 0.38,
      "splashColor": "#e8f6f8",
      "bubbleColor": "#f4fcfd",
      "glassAlpha": 0.14,
      "glass": "#eaf6fb"
    }
  },
