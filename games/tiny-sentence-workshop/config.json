{
  "format": "qlobe-game-config",
  "formatVersion": 1,
  "id": "tiny-sentence-workshop",
  "title": "Tiny Sentence Workshop",
  "category": "reading-phonics",
  "status": "beta",
  "artWorld": "Claymation",
  "roundsPerSession": 3,
  "modes": [
    { "id": "read-strip", "title": "Tap & Read", "shortTitle": "Read", "skill": "left-to-right print tracking and decoding", "introKey": "mode-read", "prompt": "Tap each word", "color": "coral" },
    { "id": "build-strip", "title": "Build the Strip", "shortTitle": "Build", "skill": "sentence word order", "introKey": "mode-build", "prompt": "Put the words in order", "color": "mustard" },
    { "id": "scene-check", "title": "Scene Detective", "shortTitle": "Detective", "skill": "literal sentence comprehension", "introKey": "mode-scene", "prompt": "Which scene matches?", "color": "grape" }
  ],
  "corpus": [
    { "id": "cat-nap", "sentence": "A cat can nap.", "scene": "./assets/scenes/cat-nap.webp", "choices": ["cat-nap", "cat-hop", "dog-nap"] },
    { "id": "cat-hop", "sentence": "A cat can hop.", "scene": "./assets/scenes/cat-hop.webp", "choices": ["cat-hop", "cat-nap", "dog-dig"] },
    { "id": "dog-nap", "sentence": "A dog can nap.", "scene": "./assets/scenes/dog-nap.webp", "choices": ["dog-nap", "cat-nap", "dog-dig"] },
    { "id": "dog-dig", "sentence": "A dog can dig.", "scene": "./assets/scenes/dog-dig.webp", "choices": ["dog-dig", "dog-nap", "cat-hop"] },
    { "id": "pig-jog", "sentence": "A pig can jog.", "scene": "./assets/scenes/pig-jog.webp", "choices": ["pig-jog", "pig-sit", "hen-run"] },
    { "id": "pig-sit", "sentence": "A pig can sit.", "scene": "./assets/scenes/pig-sit.webp", "choices": ["pig-sit", "pig-jog", "hen-sit"] },
    { "id": "hen-sit", "sentence": "A hen can sit.", "scene": "./assets/scenes/hen-sit.webp", "choices": ["hen-sit", "hen-run", "pig-sit"] },
    { "id": "hen-run", "sentence": "A hen can run.", "scene": "./assets/scenes/hen-run.webp", "choices": ["hen-run", "hen-sit", "pig-jog"] },
    { "id": "fox-box", "sentence": "A fox is in a box.", "scene": "./assets/scenes/fox-box.webp", "choices": ["fox-box", "fox-log", "bug-mug"] },
    { "id": "fox-log", "sentence": "A fox is on a log.", "scene": "./assets/scenes/fox-log.webp", "choices": ["fox-log", "fox-box", "bug-rug"] },
    { "id": "bug-rug", "sentence": "A bug is on a rug.", "scene": "./assets/scenes/bug-rug.webp", "choices": ["bug-rug", "bug-mug", "fox-log"] },
    { "id": "bug-mug", "sentence": "A bug is in a mug.", "scene": "./assets/scenes/bug-mug.webp", "choices": ["bug-mug", "bug-rug", "fox-box"] }
  ],
  "heartWords": ["a", "is"],
  "decodabilityNote": "Controlled short-vowel decodable vocabulary. Fox and box end in x, representing /k/ /s/, so they are not strict three-phoneme CVC words.",
  "tokens": [
    { "text": "a", "kind": "heart" },
    { "text": "is", "kind": "heart" },
    { "text": "in", "kind": "decodable", "phonemes": ["/i/", "/n/"] },
    { "text": "on", "kind": "decodable", "phonemes": ["/o/", "/n/"] },
    { "text": "can", "kind": "decodable", "phonemes": ["/k/", "/a/", "/n/"] },
    { "text": "cat", "kind": "decodable", "phonemes": ["/k/", "/a/", "/t/"] },
    { "text": "dog", "kind": "decodable", "phonemes": ["/d/", "/o/", "/g/"] },
    { "text": "pig", "kind": "decodable", "phonemes": ["/p/", "/i/", "/g/"] },
    { "text": "hen", "kind": "decodable", "phonemes": ["/h/", "/e/", "/n/"] },
    { "text": "fox", "kind": "decodable", "phonemes": ["/f/", "/o/", "/k/", "/s/"] },
    { "text": "bug", "kind": "decodable", "phonemes": ["/b/", "/u/", "/g/"] },
    { "text": "nap", "kind": "decodable", "phonemes": ["/n/", "/a/", "/p/"] },
    { "text": "hop", "kind": "decodable", "phonemes": ["/h/", "/o/", "/p/"] },
    { "text": "dig", "kind": "decodable", "phonemes": ["/d/", "/i/", "/g/"] },
    { "text": "jog", "kind": "decodable", "phonemes": ["/j/", "/o/", "/g/"] },
    { "text": "sit", "kind": "decodable", "phonemes": ["/s/", "/i/", "/t/"] },
    { "text": "run", "kind": "decodable", "phonemes": ["/r/", "/u/", "/n/"] },
    { "text": "box", "kind": "decodable", "phonemes": ["/b/", "/o/", "/k/", "/s/"] },
    { "text": "log", "kind": "decodable", "phonemes": ["/l/", "/o/", "/g/"] },
    { "text": "rug", "kind": "decodable", "phonemes": ["/r/", "/u/", "/g/"] },
    { "text": "mug", "kind": "decodable", "phonemes": ["/m/", "/u/", "/g/"] }
  ]
}
