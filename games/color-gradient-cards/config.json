{
  "id": "color-gradient-cards",
  "title": "Color Gradient Cards",
  "rounds": 3,
  "artDirection": "papercraft",
  "assets": {
    "backdrop": "./assets/atelier-backdrop.webp",
    "title": "./assets/title.webp",
    "reward": "./assets/reward-ribbon.webp",
    "rack": "./assets/spectrum-rack.webp",
    "tray": "./assets/card-tray.webp",
    "press": "./assets/mixer-press.webp",
    "safariFrame": "./assets/safari-frame.webp",
    "home": "./assets/ui/btn-home.webp",
    "back": "./assets/ui/btn-back.webp",
    "sound": "./assets/ui/btn-sound.webp",
    "playButton": "./assets/ui/btn-play.webp"
  },
  "audio": {
    "manifest": "./assets/audio/manifest.json",
    "lines": "./assets/audio/lines.json"
  },
  "modes": [
    {
      "id": "spectrum",
      "title": "Spectrum Studio",
      "description": "Order shades from light to dark",
      "art": "./assets/ui/mode-spectrum.webp",
      "voice": "mode-spectrum"
    },
    {
      "id": "mixer",
      "title": "Color Mixer",
      "description": "Build a bridge between two colors",
      "art": "./assets/ui/mode-mixer.webp",
      "voice": "mode-mixer"
    },
    {
      "id": "safari",
      "title": "Shade Safari",
      "description": "Match colors in the paper garden",
      "art": "./assets/ui/mode-safari.webp",
      "voice": "mode-safari"
    }
  ],
