      "blue": { "label": "Blue", "card": "./assets/cards/rainbow-5.webp" }
    },
    "bridges": [
      {
        "id": "red-yellow",
        "colors": ["red", "yellow"],
        "result": "orange",
        "voice": "result-orange",
        "palette": ["#e84b44", "#ea663c", "#ee7f37", "#f09a3b", "#f3d44b"],
        "cards": ["./assets/cards/mix-red-yellow-1.webp", "./assets/cards/mix-red-yellow-2.webp", "./assets/cards/mix-red-yellow-3.webp", "./assets/cards/mix-red-yellow-4.webp", "./assets/cards/mix-red-yellow-5.webp"]
      },
      {
        "id": "yellow-blue",
        "colors": ["yellow", "blue"],
        "result": "green",
        "voice": "result-green",
        "palette": ["#f3d44b", "#b2ca4c", "#64aa57", "#4d9a84", "#3783c5"],
        "cards": ["./assets/cards/mix-yellow-blue-1.webp", "./assets/cards/mix-yellow-blue-2.webp", "./assets/cards/mix-yellow-blue-3.webp", "./assets/cards/mix-yellow-blue-4.webp", "./assets/cards/mix-yellow-blue-5.webp"]
      },
      {
        "id": "red-blue",
        "colors": ["red", "blue"],
        "result": "purple",
        "voice": "result-purple",
        "palette": ["#e84b44", "#c34f73", "#9b548f", "#6d60ad", "#3783c5"],
        "cards": ["./assets/cards/mix-red-blue-1.webp", "./assets/cards/mix-red-blue-2.webp", "./assets/cards/mix-red-blue-3.webp", "./assets/cards/mix-red-blue-4.webp", "./assets/cards/mix-red-blue-5.webp"]
      }
    ]
  },
  "safari": {
    "rounds": 3,
    "objects": [
      {
        "id": "apple",
        "label": "apple",
        "colorLabel": "red",
        "asset": "./assets/safari/apple.webp",
        "target": "#e84b44",
        "voice": "safari-apple",
        "choices": [
          { "id": "apple-light", "hex": "#f27d75", "card": "./assets/cards/reds-2.webp" },
          { "id": "apple-match", "hex": "#e84b44", "card": "./assets/cards/reds-3.webp", "correct": true },
          { "id": "apple-dark", "hex": "#c6283b", "card": "./assets/cards/reds-4.webp" }
        ]
      },
      {
        "id": "sunflower",
        "label": "sunflower",
        "colorLabel": "golden",
        "asset": "./assets/safari/sunflower.webp",
        "target": "#f3d44b",
        "voice": "safari-sunflower",
        "choices": [
          { "id": "sunflower-light", "hex": "#fde59a", "card": "./assets/cards/gold-1.webp" },
          { "id": "sunflower-match", "hex": "#f3d44b", "card": "./assets/cards/gold-2.webp", "correct": true },
          { "id": "sunflower-dark", "hex": "#c99428", "card": "./assets/cards/gold-3.webp" }
        ]
      },
      {
        "id": "leaf",
        "label": "leaf",
        "colorLabel": "green",
        "asset": "./assets/safari/leaf.webp",
        "target": "#58a958",
        "voice": "safari-leaf",
        "choices": [
          { "id": "leaf-light", "hex": "#9dce88", "card": "./assets/cards/greens-2.webp" },
          { "id": "leaf-match", "hex": "#58a958", "card": "./assets/cards/greens-3.webp", "correct": true },
          { "id": "leaf-dark", "hex": "#2f7b46", "card": "./assets/cards/greens-4.webp" }
        ]
      },
      {
        "id": "ocean",
        "label": "ocean wave",
        "colorLabel": "blue",
        "asset": "./assets/safari/ocean.webp",
        "target": "#3893ca",
        "voice": "safari-ocean",
        "choices": [
          { "id": "ocean-light", "hex": "#85c8e8", "card": "./assets/cards/blues-2.webp" },
          { "id": "ocean-match", "hex": "#3893ca", "card": "./assets/cards/blues-3.webp", "correct": true },
          { "id": "ocean-dark", "hex": "#1e5f9b", "card": "./assets/cards/blues-4.webp" }
        ]
      },
      {
        "id": "berries",
        "label": "berries",
        "colorLabel": "purple",
        "asset": "./assets/safari/berries.webp",
        "target": "#946ac3",
        "voice": "safari-berries",
        "choices": [
          { "id": "berries-light", "hex": "#c5a0e0", "card": "./assets/cards/purples-2.webp" },
          { "id": "berries-match", "hex": "#946ac3", "card": "./assets/cards/purples-3.webp", "correct": true },
          { "id": "berries-dark", "hex": "#684397", "card": "./assets/cards/purples-4.webp" }
        ]
      }
    ]
