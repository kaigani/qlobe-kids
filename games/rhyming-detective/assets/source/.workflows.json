:null,"max":null,"options":null},{"name":"width","type":"integer","required":false,"default":1008,"min":null,"max":null,"options":null},{"name":"height","type":"integer","required":false,"default":1024,"min":null,"max":null,"options":null},{"name":"steps","type":"integer","required":false,"default":20,"min":null,"max":null,"options":null}],"outputs":[{"name":"output0","type":"image"}]},{"id":"geeky-kokoro-tts","name":"Geeky Kokoro TTS","description":"Text-to-speech with Kokoro-82M (54+ voices, 9 languages).\n\nPHONEME MODE: set use_phonemes=true to bypass grapheme-to-phoneme (g2p) conversion and put a phoneme string directly in the 'text' field. One line = one segment, max 510 phonemes per line.\n\nIMPORTANT: Kokoro uses misaki's phoneme set, NOT raw IPA. Symbols outside its vocab (e.g. plain lowercase 'o') are SILENTLY DROPPED.\n\nVowel symbols (American English): A=face(eɪ), I=price(aɪ), O=goat/\"oh\"(oʊ), W=mouth(aʊ), Y=choice(ɔɪ), ə=schwa/\"uh\". Use capital O for an \"oh\" sound — lowercase o won't work. Other consonants/vowels follow IPA (k, ɹ, ʃ, ʒ, ŋ, ð, θ, ʧ, ʤ, etc.).\n\nSTRESS: ˈ = primary, ˌ = secondary, placed BEFORE the stressed syllable. Unstressed vowels get reduced (flatter/centralized) — add ˌ before a vowel to keep it full.\n\nEXAMPLE: 'kokoro' as evenly-pronounced full vowels → kˈOkˌOɹˌO . The softer g2p default is kˈOkəɹO (middle reduces to schwa, final 'oh' weakens).","inputs":[{"name":"text","type":"string","required":true,"default":null,"min":null,"max":null,"options":null},{"name":"voice","type":"string","required":false,"default":"🇺🇸 🚺 Heart ❤️","min":null,"max":null,"options":["🇺🇸 🚺 Heart ❤️","🇺🇸 🚺 Bella 🔥","🇺🇸 🚺 Nicole 🎧","🇺🇸 🚺 Aoede 🎵","🇺🇸 🚺 Kore","🇺🇸 🚺 Sarah","🇺🇸 🚺 Nova ⭐","🇺🇸 🚺 Sky ☁️","🇺🇸 🚺 Alloy","🇺🇸 🚺 Jessica","🇺🇸 🚺 River 🌊","🇺🇸 🚹 Michael","🇺🇸 🚹 Fenrir 🐺","🇺🇸 🚹 Puck 🎭","🇺🇸 🚹 Echo 🔊","🇺🇸 🚹 Eric","🇺🇸 🚹 Liam","🇺🇸 🚹 Onyx 💎","🇺🇸 🚹 Adam","🇺🇸 🚹 Santa 🎅","🇬🇧 🚺 Emma","🇬🇧 🚺 Isabella","🇬🇧 🚺 Alice 📚","🇬🇧 🚺 Lily 🌸","🇬🇧 🚹 George","🇬🇧 🚹 Fable 📖","🇬🇧 🚹 Lewis","🇬🇧 🚹 Daniel","🇯🇵 🚺 Alpha α","🇯🇵 🚺 Gongitsune 権狐","🇯🇵 🚺 Nezumi 鼠","🇯🇵 🚺 Tebukuro 手袋","🇯🇵 🚹 Kumo 蜘蛛","🇨🇳 🚺 Xiaobei 小贝","🇨🇳 🚺 Xiaoni 小妮","🇨🇳 🚺 Xiaoxiao 小小","🇨🇳 🚺 Xiaoyi 小艺","🇨🇳 🚹 Yunjian 云健","🇨🇳 🚹 Yunxi 云希","🇨🇳 🚹 Yunxia 云霞","🇨🇳 🚹 Yunyang 云扬","🇪🇸 🚺 Dora","🇪🇸 🚹 Alex","🇪🇸 🚹 Santa 🎅","🇫🇷 🚺 Siwis","🇮🇳 🚺 Alpha α","🇮🇳 🚺 Beta β","🇮🇳 🚹 Omega Ω","🇮🇳 🚹 Psi Ψ","🇮🇹 🚺 Sara","🇮🇹 🚹 Nicola","🇧🇷 🚺 Dora","🇧🇷 🚹 Alex","🇧🇷 🚹 Santa 🎅"]},{"name":"speed","type":"float","required":false,"default":1.0,"min":0.5,"max":2.0,"options":null},{"name":"use_phonemes","type":"boolean","required":false,"default":false,"min":null,"max":null,"options":null}],"outputs":[{"name":"output0","type":"audio"}]},{"id":"hunyuan3d-2.1","name":"Hunyuan3D 2.1","description":"Generate a textured 3D mesh (GLB) from a single reference image using Hunyuan3D 2.1","inputs":[{"name":"image","type":"image","required":true,"default":null,"min":null,"max":null,"options":null},{"name":"seed","type":"integer","required":false,"default":0,"min":null,"max":null,"options":null},{"name":"steps","type":"integer","required":false,"default":30,"min":1,"max":100,"options":null},{"name":"cfg","type":"float","required":false,"default":5,"min":0,"max":20,"options":null},{"name":"resolution","type":"integer","required":false,"default":4096,"min":1,"max":8192,"options":null},{"name":"octree_resolution","type":"integer","required":false,"default":256,"min":16,"max":512,"options":null},{"name":"num_chunks","type":"integer","required":false,"default":8000,"min":1000,"max":500000,"options":null},{"name":"mesh_threshold","type":"float","required":false,"default":0.6,"min":-1,"max":1,"options":null},{"name":"mesh_algorithm","type":"string","required":false,"default":"surface net","min":null,"max":null,"options":["surface net","basic"]}],"outputs":[{"name":"mesh","type":"model"}]},{"id":"ideogram4-t2i","name":"Ideogram 4.0 Text to Image","description":"Generate an image from a structured JSON caption using Ideogram 4.0. The prompt must be a structured JSON caption (aspect_ratio + high_level_description + compositional_deconstruction) produced by the magic-prompt template in prompt_template.md.","inputs":[{"name":"prompt","type":"string","required":true,"default":null,"min":null,"max":null,"options":null},{"name":"width","type":"integer","required":false,"default":1376,"min":256,"max":4096,"options":null},{"name":"height","type":"integer","required":false,"default":768,"min":256,"max":4096,"options":null},{"name":"seed","type":"integer","required":false,"default":128851435653232,"min":null,"max":null,"options":null},{"name":"quality","type":"string","required":false,"default":"Default","min":null,"max":null,"options":["Quality","Default","Turbo"]},{"name":"cfg","type":"number","required":false,"default":7,"min":1,"max":20,"options":null}],"outputs":[{"name":"output0","type":"image"}]},{"id":"krea2-turbo-t2i","name":"Krea2 Turbo Text to Image","description":"Fast text-to-image generation with Krea2 Turbo (8-step distilled, CFG 1).","inputs":[{"name":"prompt","type":"string","required":true,"default":null,"min":null,"max":null,"options":null},{"name":"width","type":"integer","required":false,"default":1024,"min":256,"max":4096,"options":null},{"name":"height","type":"integer","required":false,"default":1024,"min":256,"max":4096,"options":null},{"name":"seed","type":"integer","required":false,"default":593137214414658,"min":null,"max":null,"options":null},{"name":"steps","type":"integer","required":false,"default":8,"min":1,"max":50,"options":null},{"name":"cfg","type":"number","required":false,"default":1,"min":1,"max":20,"options":null}],"outputs":[{"name":"output0","type":"image"}]},{"id":"ltx2","name":"LTX-2 Consolidated","description":"Consolidated LTX-2 19B endpoint: text-to-video, image-to-video, with optional audio, last frame, and detailer","inputs":[{"name":"prompt","type":"string","required":true,"default":null,"min":null,"max":null,"options":null},{"name":"negative_prompt","type":"string","required":false,"default":"blurry, low quality, still frame, frames, watermark, overlay, titles, has blurbox, has subtitles","min":null,"max":null,"options":null},{"name":"first_frame","type":"image","required":false,"default":null,"min":null,"max":null,"options":null},{"name":"last_frame","type":"image","required":false,"default":null,"min":null,"max":null,"options":null},{"name":"audio","type":"audio","required":false,"default":null,"min":null,"max":null,"options":null},{"name":"width","type":"integer","required":false,"default":1920,"min":null,"max":null,"options":null},{"name":"height","type":"integer","required":false,"default":1088,"min":null,"max":null,"options":null},{"name":"seed","type":"integer","required":false,"default":10,"min":null,"max":null,"options":null},{"name":"frame_count","type":"integer","required":false,"default":501,"min":null,"max":null,"options":null},{"name":"audio_duration","type":"integer","required":false,"default":20,"min":null,"max":null,"options":null},{"name":"detailer","type":"float","required":false,"default":0,"min":null,"max":null,"options":null}],"outputs":[{"name":"output0","type":"video"}]},{"id":"ltx2-3","name":"LTX-2.3","description":"LTX-2.3 22B distilled (fp8) two-pass video generation with spatial upscaling and MelBandRoFormer audio enhancement. Supports text-to-video and image-to-video with optional audio and last frame guide.","inputs":[{"name":"prompt","type":"string","required":true,"default":null,"min":null,"max":null,"options":null},{"name":"negative_prompt","type":"string","required":false,"default":"blurry, low resolution, ugly, garbled mess, compression artifacts, glitch, stop motion, still image, pixelated, robotic voice, oversaturated","min":null,"max":null,"options":null},{"name":"first_frame","type":"image","required":false,"default":null,"min":null,"max":null,"options":null},{"name":"last_frame","type":"image","required":false,"default":null,"min":null,"max":null,"options":null},{"name":"audio","type":"au