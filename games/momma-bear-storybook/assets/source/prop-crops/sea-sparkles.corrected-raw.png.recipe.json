    {
      "op": "chroma-cutout",
      "tool": "tools/cutout-to-webp.mjs",
      "key": "#ef0392",
      "keyFilter": "chromakey",
      "similarity": 0.16,
      "blend": 0.03,
      "alphaErodePx": 2,
      "alphaCutoff": 32,
      "despill": false,
      "padding": 16,
      "quality": 91,
      "output": "assets/props/sea-sparkles.webp"
    }
  ],
  "qa": {
    "status": "accepted",
    "backgrounds": ["#10101a", "#f3e4c5", "little-mill-harbor.webp"],
