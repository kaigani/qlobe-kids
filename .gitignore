# macOS junk
.DS_Store
._*

# Windows junk
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp

# QA screenshots/reports from Playwright verification runs — not shippable assets
**/qa-shots/

# Node (defensive — this is a no-build static site)
node_modules/

# Logs
*.log

# Local Claude Code settings (the shipped skill in .claude/skills/ IS tracked)
.claude/settings.local.json

# Local python venv for lipsync tooling (machine-specific)
tools/lipsync/venv/

# Persistent authoring-server job store (runtime state — regenerated, never committed)
tools/state/

# Python bytecode (server/tool test runs)
__pycache__/
*.pyc

# Scratch dumps from asset-production passes. Intermediates live here while a batch is
# being generated and QA'd; the finished assets are copied into shared/assets/ or the
# game's own assets/ and THOSE are what ship. A 200 MB tmp/objects-webp/ dump duplicating
# shared/assets/objects/ byte-for-byte nearly went into history from here.
tmp/
